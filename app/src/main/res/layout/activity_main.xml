<android.support.v7.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ⭐ TÍTULO CENTRADO -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WHAT'S THIS?"
            android:textSize="42sp"
            android:visibility="invisible"
            android:textStyle="bold"
            android:textColor="@color/colorPurple"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginBottom="40dp"
            android:layout_marginTop="40dp"/>

        <!-- ⭐ HELP ARRIBA DERECHA -->
        <!-- ⭐ HELP ARRIBA DERECHA -->
        <LinearLayout
            android:id="@+id/helpContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="top|end"
            android:layout_margin="16dp">

            <ImageButton
                android:id="@+id/btnHelp"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/help"
                android:scaleType="fitXY"
                android:background="@null"
                android:contentDescription="Help"/>

            <TextView
                android:id="@+id/helpText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HELP"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/colorPurple"/>

        </LinearLayout>


        <!-- ⭐ TU CONTENIDO CENTRADO -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="80dp"
                android:gravity="center"
                android:padding="16dp">

                <ImageButton
                    android:id="@+id/imagen"
                    android:layout_width="400dp"
                    android:visibility="invisible"
                    android:layout_height="400dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/banana"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="16dp"/>

                <Button
                    android:id="@+id/btnImagen"
                    android:layout_width="500dp"
                    android:layout_height="wrap_content"
                    android:visibility="invisible"

                    android:text="Tap to tell me what it is"
                    android:background="@drawable/button_rounded"
                    android:textColor="@color/colorWhite"
                    android:textSize="30sp"/>
                <Button
                    android:id="@+id/btnSkip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="skip ⏭"
                    android:visibility="invisible"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/colorWhite"
                    android:background="@drawable/button_rounded"/>

            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/loadingBox"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="40dp"
            android:padding="40dp"
            android:background="@drawable/bg_dialog_rounded"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center">

            <TextView
                android:id="@+id/instruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Say what you see in the image!"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="32sp"
                android:gravity="center"
                android:textAlignment="center"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="16dp">

                <Button
                    android:id="@+id/sayitagain"
                    android:layout_height="48dp"
                    android:layout_width="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="SAY IT AGAIN"
                    android:background="@drawable/btn_rounded_t"
                    android:textColor="@color/colorBlack"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:padding="12dp"/>

                <Button
                    android:id="@+id/skip"
                    android:layout_height="48dp"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="SKIP"
                    android:background="@drawable/btn_rounded_t"
                    android:textColor="@color/colorBlack"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:padding="12dp"/>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</android.support.v7.widget.LinearLayoutCompat>